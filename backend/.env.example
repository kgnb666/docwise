# ===== DocWise 后端配置（复制为 .env 后填写）=====
# 复制命令：cp .env.example .env

# 服务
APP_NAME=DocWise
HOST=0.0.0.0
PORT=8000
# 分词：auto（装了 jieba 就用，否则回退）| legacy（零依赖）| jieba（强制）
TOKENIZER=auto

# LLM（OpenAI 兼容接口；换 DeepSeek/通义只需改 base_url 和 model）
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-your-deepseek-key
LLM_MODEL=deepseek-chat
# 嵌入接口独立配置（可选）：DeepSeek 无嵌入 API，用硅基流动 bge-m3；留空则复用上面
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-your-siliconflow-key
EMBEDDING_MODEL=BAAI/bge-m3
# 嵌入实现：openai（真实接口）| hash（离线哈希，无需 Key，测试/原型用）
EMBEDDING_PROVIDER=openai
TEMPERATURE=0.2
MAX_TOKENS=1024

# 检索参数
TOP_K=5
RERANK_TOP_K=3
CHUNK_SIZE=800
CHUNK_OVERLAP=100
# 混合检索权重：0~1，越大越偏向关键词（BM25）
HYBRID_ALPHA=0.4
# Rerank：null（不重排）| overlap（轻量重叠精排，MVP）
RERANKER=overlap
RERANK_ALPHA=0.3
# 相关度阈值（原始余弦）：无关≈0.3、相关≈0.67（实测），取 0.4
SCORE_THRESHOLD=0.4

# Agent 工具调用
AGENT_ENABLED=true
AGENT_MAX_TURNS=5

# 追问改写
QUERY_REWRITE_ENABLED=true

# 知识库未命中时的兜底：strict（只答知识库）| chat（允许常识/联网回答）
FALLBACK_MODE=chat

# 检索结果缓存（热点问答跳过 embedding 调用）
RETRIEVAL_CACHE_ENABLED=true
RETRIEVAL_CACHE_TTL=300

# 限流（按 IP 令牌桶）
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_PER_SEC=1.0

# CORS 白名单（前端 dev server 地址）
CORS_ORIGINS=["http://localhost:5173"]
